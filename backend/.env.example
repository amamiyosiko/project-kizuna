APP_NAME=Amazon CS AI
ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amazon_cs_ai
JWT_SECRET_KEY=change_this_secret
CONFIG_ENCRYPTION_KEY=change_this_config_encryption_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
AWS_REGION=ap-northeast-3
S3_BUCKET_NAME=project-kizuna-amazon-s3-osaka
AWS_S3_BUCKET=project-kizuna-amazon-s3-osaka
S3_UPLOAD_EXPIRES_SECONDS=900

# Amazon SP-API production connection (v0.3.4.1)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=
AMAZON_REGION=jp

# SP-API AWS signing credentials
# If your EC2 role has SP-API signing permission, these can be empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
